{
  "name": "gentestx",
  "displayName": "GenTestX",
  "description": "VS Code extension for generating test cases using Groq AI",
  "version": "2.8.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/22882917/gentestx"
  },
  "publisher": "gentestx",
  "icon": "resources/icon.jpg",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gentestx-sidebar",
          "title": "GenTestX",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "gentestx-sidebar": [
        {
          "type": "webview",
          "id": "gentestx.analysisView",
          "name": "Test Generator"
        }
      ]
    },
    "commands": [
      {
        "command": "gentestx.analyzeCode",
        "title": "GenTestX: Analyze Code and Generate Tests"
      },
      {
        "command": "gentestx.analyzeLine",
        "title": "GenTestX: Analyze Current Line"
      },
      {
        "command": "gentestx.analyzeFile",
        "title": "GenTestX: Analyze Entire File"
      },
      {
        "command": "gentestx.selectFile",
        "title": "GenTestX: Select and Analyze File"
      },
      {
        "command": "gentestx.fixCode",
        "title": "GenTestX: Fix Code Issue"
      },
      {
        "command": "gentestx.acceptFix",
        "title": "GenTestX: Accept Fix Suggestion"
      },
      {
        "command": "gentestx.rejectFix",
        "title": "GenTestX: Reject Fix Suggestion"
      },
      {
        "command": "gentestx.showFixSuggestion",
        "title": "GenTestX: Show Fix Suggestion"
      },
      {
        "command": "gentestx.toggleAutoAnalysis",
        "title": "GenTestX: Toggle Automatic Code Analysis"
      },
      {
        "command": "gentestx.generateCode",
        "title": "GenTestX: Generate Code and Create File"
      }
    ],
    "keybindings": [
      {
        "command": "gentestx.analyzeLine",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "gentestx.analyzeFile",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "gentestx.selectFile",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      },
      {
        "command": "gentestx.analyzeCode",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "GenTestX",
      "properties": {
        "gentestx.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Groq AI. You can get one at https://console.groq.com/",
          "markdownDescription": "API key for Groq AI. You can get one at [https://console.groq.com/](https://console.groq.com/)"
        },
        "gentestx.defaultMode": {
          "type": "string",
          "enum": [
            "chat",
            "gentestx"
          ],
          "default": "chat",
          "description": "Default mode for the GenTestX extension (chat or gentestx AI)"
        },
        "gentestx.defaultLanguage": {
          "type": "string",
          "enum": [
            "javascript",
            "typescript",
            "python",
            "java",
            "csharp",
            "cpp",
            "go",
            "rust",
            "php",
            "ruby"
          ],
          "default": "javascript",
          "description": "Default programming language for code analysis"
        },
        "gentestx.autoAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze code as you type and show fix suggestions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "ts-node ./scripts/build.ts",
    "watch": "ts-node ./scripts/build.ts --watch",
    "lint": "eslint src --ext ts,tsx",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/vscode": "^1.99.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.18.11",
    "eslint": "^8.45.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
